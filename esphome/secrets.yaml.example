# secrets.yaml.example
#
# コピーして `secrets.yaml` を作成し、実際の値を入れる。
# secrets.yaml は .gitignore済み。誤ってコミットしないこと。
#
# 注: WiFi情報(ssid/password)はここには置かない。
#     improv_serial経由でシリアルプロビジョニングし、
#     デバイス上のNVSに実行時保存する方式に変更したため、
#     wifi_ssid/wifi_passwordのようなsecretは不要になった。

# `esphome secrets` や `openssl rand -base64 32` などで生成した32byte鍵
api_encryption_key: "REPLACE_WITH_GENERATED_KEY"
